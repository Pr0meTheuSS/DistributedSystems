{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/api/hash-cracks": {
            "post": {
                "description": "Принимает хэш и максимальную длину пароля, возвращает ID задачи и статус",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "crack-hash"
                ],
                "summary": "Отправить задачу на перебор хэша",
                "parameters": [
                    {
                        "description": "Параметры задачи",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.CrackHashRequestDto"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/dto.CrackHashResponseDto"
                        }
                    },
                    "400": {
                        "description": "Невалидный запрос",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Ошибка на сервере",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/hash-cracks/{id}/progress": {
            "get": {
                "description": "Принимает ID задачи, возвращает текущий прогресс выполнения задачи.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "crack-hash"
                ],
                "summary": "Получить текущий прогресс задачи.",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Уникальный идентификатор задачи (ID)",
                        "name": "id",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.CrackHashProgressDto"
                        }
                    },
                    "400": {
                        "description": "Невалидный запрос",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Задача по данному идентификатору не найдена",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Ошибка на сервере",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/hash-cracks/{id}/result": {
            "get": {
                "description": "Принимает ID задачи, возвращает результат выполнения.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "crack-hash"
                ],
                "summary": "Получить результат задачи.",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Уникальный идентификатор задачи (Id)",
                        "name": "id",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.CrackHashResultDto"
                        }
                    },
                    "400": {
                        "description": "Невалидный запрос",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Задача по данному идентификатору не найдена",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Ошибка на сервере",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
