            "type": "object",
            "properties": {
                "current_handling_duration": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "progress_in_percents": {
                    "type": "number"
                }
            }
        },
        "dto.CrackHashRequestDto": {
            "type": "object",
            "properties": {
                "alphabet": {
                    "type": "string"
                },
                "hash": {
                    "type": "string"
                },
                "length": {
                    "type": "integer"
                }
            }
        },
        "dto.CrackHashResponseDto": {
            "type": "object",
            "properties": {
                "alphabet": {
                    "type": "string"
                },
                "create_at": {
                    "type": "string"
                },
                "finished_at": {
                    "type": "string"
                },
                "hash": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "length": {
                    "type": "integer"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "dto.CrackHashResultDto": {
            "type": "object",
            "properties": {
                "answers": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "id": {
                    "type": "string"
                }
            }
        }
    }
}